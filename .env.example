APP_ENV=development
SECRET_KEY=change-me
# Local default is SQLite. For local Postgres: postgresql://user:pass@localhost:5432/parkpilot
DATABASE_URL=sqlite:///parkpilot.db
SITE_URL=
SUPPORTED_LOCALES=de,en,nl,fr,es,ar,tr
PUBLIC_TENANT_SLUG=luxury-parking
API_DEFAULT_REQUESTS_PER_MINUTE=60
API_IDEMPOTENCY_HOURS=24
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=5
SEED_TENANT_NAME="Luxury Parking"
SEED_OWNER_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-too
INSPECTION_S3_BUCKET=
INSPECTION_S3_ENDPOINT_URL=
INSPECTION_S3_REGION=eu-central-1
INSPECTION_S3_ACCESS_KEY_ID=
INSPECTION_S3_SECRET_ACCESS_KEY=
INSPECTION_MAX_PHOTO_BYTES=8388608
INSPECTION_MAX_IMAGE_PIXELS=12000000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Empty = offer every payment method enabled in the Stripe Dashboard (SEPA direct debit, PayPal, Klarna, Apple Pay, cards ...).
# Pin a list with e.g. card,sepa_debit,paypal
STRIPE_PAYMENT_METHOD_TYPES=
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=20
LOGIN_LOCK_MINUTES=15
LOG_LEVEL=INFO
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/parkpilot_test

# Legal pages (/impressum, /datenschutz, /agb). Fill these in before going live.
LEGAL_COMPANY="Luxury Parking LP GmbH"
LEGAL_REPRESENTATIVE="Ghatfan Sultan (Geschäftsführer)"
LEGAL_STREET="Sohlstättenstraße 58"
LEGAL_CITY="40880 Ratingen, Deutschland"
LEGAL_PHONE="+49 151 55886444"
LEGAL_EMAIL="info@luxuryparking.de"
LEGAL_VAT_ID="DE464781694"
LEGAL_REGISTER="Amtsgericht Düsseldorf, HRB 112578"
LEGAL_HOSTING=
LEGAL_RETENTION=

# Public business profile (footer, contact section, structured data). Defaults = luxuryparking.de; override if needed.
# BIZ_PHONE="+49 151 55886444"
BIZ_EMAIL=info@luxuryparking.de
# BIZ_INSTAGRAM=https://www.instagram.com/luxuryparkinglp
# BIZ_FACEBOOK=https://www.facebook.com/luxuryparkinglp
# BIZ_LOGO=1   # set to 0 to show a plain text brand name instead of the Luxury Parking logo

# Super user (platform admin): issues API keys and webhooks, manages all parkings. Roles: admin > owner (the parking) > staff (workers).
SEED_ADMIN_EMAIL=admin@luxuryparking.de
SEED_ADMIN_PASSWORD=
# QR_BASE_URL=   # optional: address printed in QR codes (defaults to SITE_URL; local run scripts set it automatically)

# --- Invoices, notifications (phases 10-11) ---
# VAT included in your gross prices (tenants can override under Admin > Invoices > Seller details & VAT). Confirm with your tax advisor.
DEFAULT_VAT_RATE=19
# OWNER_NOTIFY_EMAIL=you@example.com     # blind copy of new / paid / cancelled booking emails
# REVIEW_URL=https://g.page/r/...         # review link sent after check-out
REMINDER_HOURS=24                         # run `flask --app wsgi send-reminders` hourly
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=                  # WhatsApp business messages need approved templates
# Lets phone numbers starting with 0 be converted to +49...; otherwise they must be typed with the country code.
DEFAULT_PHONE_COUNTRY_CODE=+49
# Phone numbers that receive the SMS code of "Forgot your password?" (also settable in the app: Account > Phone number)
SEED_OWNER_PHONE=
SEED_ADMIN_PHONE=
# SMS_EVENTS=reserved,cancelled,reminder
# WHATSAPP_EVENTS=reserved,cancelled,reminder

# --- Platform subscriptions (phase 9) ---
TRIAL_DAYS=14
# STRIPE_BILLING_WEBHOOK_SECRET=         # endpoint: /webhooks/stripe-billing
#   events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed
# STRIPE_PRICE_STARTER=price_...         # create the 3 monthly prices in Stripe; plans without an id cannot be bought
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
# PLAN_LIMITS_JSON={"starter":{"spaces":25,"bookings":300,"api_requests":5000},"pro":{"spaces":100,"bookings":2000,"api_requests":50000},"business":{"spaces":0,"bookings":0,"api_requests":0}}

# --- Security (see SECURITY.md) ---
# SECRET_KEY must be 32+ random characters in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_LIFETIME_HOURS=12        # absolute session length
IDLE_TIMEOUT_MINUTES=120         # sign out after this long without activity (0 = off)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/1   # share rate-limit counters between workers (falls back to SOCKETIO_MESSAGE_QUEUE)

# --- AI chat assistant on the public pages (button at the bottom right) ---
# Get a key at https://console.anthropic.com . Without a key the chat still opens and answers with the parking's own facts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_CHAT_ENABLED=1
AI_CHAT_DAILY_LIMIT=2000
